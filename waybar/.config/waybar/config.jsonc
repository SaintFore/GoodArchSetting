[
  {
    "name": "full",
    "output": ["*"],
    "include": ["~/.config/waybar/common.jsonc"]
  },
  {
    "output": [],
    "name": "compact",
    "include": ["~/.config/waybar/common.jsonc"],
    "modules-left": ["niri/workspaces", "custom/pomotui"],
    "modules-center": [],
    "modules-right": [
      "privacy",
      "pulseaudio",
      "network",
      "battery",
      "clock",
      "tray",
      "custom/power"
    ],
    "network": {"max-length": 12}
  }
]
