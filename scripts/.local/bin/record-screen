#!/usr/bin/env bash
set -euo pipefail

video_dir="${XDG_VIDEOS_DIR:-$HOME/Videos}"
fps="${WF_RECORDER_FPS:-60}"
audio_device="${WF_RECORDER_AUDIO:-alsa_input.pci-0000_00_1f.3.analog-stereo}"
file="${1:-$video_dir/screen-$(date +%F-%H%M%S).mp4}"

mkdir -p "$(dirname "$file")"

exec wf-recorder \
  -r "$fps" \
  --audio="$audio_device" \
  -f "$file"
