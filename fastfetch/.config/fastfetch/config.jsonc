{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "chafa",
    "source": "~/.config/fastfetch/logo.jpg",
    "width": 40,
    "padding": {
      "top": 1,
      "right": 4,
      "left": 1,
    },
  },

  "display": {
    "separator": " 󰧟 ",
    "color": {
      "keys": "green",
      "title": "cyan",
      "output": "white",
      "separator": "magenta",
    },
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
    },
    {
      "type": "separator",
      "string": "━",
    },

    {
      "type": "os",
      "key": "󰣇  OS",
    },
    {
      "type": "kernel",
      "key": "󰌽  Kernel",
    },
    {
      "type": "uptime",
      "key": "󰔛  Uptime",
    },
    {
      "type": "packages",
      "key": "󰏖  Packages",
    },

    "break",

    {
      "type": "display",
      "key": "󰍹  Display",
      "compactType": "original",
    },
    {
      "type": "wm",
      "key": "  Compositor",
    },
    {
      "type": "terminal",
      "key": "  Terminal",
    },
    {
      "type": "terminalfont",
      "key": "󰛖  Font",
    },
    {
      "type": "shell",
      "key": "  Shell",
    },
    {
      "type": "editor",
      "key": "  Editor",
    },

    "break",

    {
      "type": "cpu",
      "key": "  CPU",
      "temp": true,
    },
    {
      "type": "gpu",
      "key": "󰢮  GPU",
      "temp": true,
    },
    {
      "type": "memory",
      "key": "󰍛  Memory",
    },
    {
      "type": "swap",
      "key": "󰓡  Swap",
    },
    {
      "type": "disk",
      "key": "󰋊  Root",
      "folders": "/",
    },
    {
      "type": "disk",
      "key": "󰉋  Home",
      "folders": "/home",
    },
    {
      "type": "battery",
      "key": "󰁹  Battery",
    },

    "break",

    {
      "type": "command",
      "key": "  Git",
      "text": "git --version 2>/dev/null | cut -d' ' -f3",
    },
    {
      "type": "command",
      "key": "  Neovim",
      "text": "nvim --version 2>/dev/null | head -n1 | awk '{print $2}'",
    },
    {
      "type": "command",
      "key": "  Node",
      "text": "node --version 2>/dev/null",
    },
    {
      "type": "command",
      "key": "  Python",
      "text": "python --version 2>/dev/null | awk '{print $2}'",
    },
    {
      "type": "command",
      "key": "  Rust",
      "text": "rustc --version 2>/dev/null | awk '{print $2}'",
    },
    {
      "type": "command",
      "key": "  Go",
      "text": "go version 2>/dev/null | awk '{print $3}'",
    },
    {
      "type": "command",
      "key": "  Godot",
      "text": "godot --version 2>/dev/null | awk '{print $1}'",
    },
    {
      "type": "command",
      "key": "󰫢  Claude",
      "text": "claude --version 2>/dev/null | awk '{print $1}'",
    },

    "break",

    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2,
    },
    {
      "type": "custom",
      "format": "\u001b[1;36m󰣇  元亨利贞\u001b[0m",
    },
  ],
}
