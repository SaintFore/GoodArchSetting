# --- 基础布局 ---
sort=-time
layer=overlay
background-color=#1a1b26
width=300
height=110
border-size=2
border-color=#7aa2f7
border-radius=5
icons=1
max-icon-size=48
# 5秒后自动消失，设为0则不消失
default-timeout=5000
# 即使设置了不消失，鼠标悬停时也重置计时器
ignore-timeout=1

# --- 字体与文本 ---
font=MonaspiceNe Nerd Font Propo 12
text-color=#c0caf5
margin=10
padding=15

# --- 位置 (右上角) ---
anchor=top-right

# 弹出时有音乐
on-notify=exec paplay /usr/share/sounds/ocean/stereo/message-sent-instant.oga

[app-name=translate-clipboard]
anchor=center
layer=overlay
width=900
height=700
padding=16
margin=0
text-alignment=left
default-timeout=8000
